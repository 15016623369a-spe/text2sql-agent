# Copy to .env.production.local and restrict file permissions.
RAG_DOMAIN=localhost
RAG_GATEWAY_BIND=127.0.0.1
RAG_HTTP_PORT=18080
RAG_HTTPS_PORT=18443
RAG_GATEWAY_KEY=
RAG_USERS_FILE=
RAG_SANDBOX_IMAGE=rag-step7-sandbox:release-1
RAG_DOCKER_SOCKET=/var/run/docker.sock
RAG_LANGSMITH_EXPORT=false
LLM_API_KEY=
# Optional USD rates per million cache-hit input, uncached input, and output tokens.
RAG_MODEL_PRICE_USD_PER_MILLION=

# Optional deployment-managed, read-only PostgreSQL source.
RAG_POSTGRES_HOST=
RAG_POSTGRES_PORT=5432
RAG_POSTGRES_DATABASE=
RAG_POSTGRES_USER=
RAG_POSTGRES_PASSWORD=
RAG_POSTGRES_SCHEMA=
RAG_POSTGRES_SSLMODE=verify-full
# Optional path to a mounted CA certificate inside the API container.
RAG_POSTGRES_SSLROOTCERT=
